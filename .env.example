# --- Rust service ---
BIND=127.0.0.1:3000
PB_URL=http://127.0.0.1:8090
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# true behind HTTPS in production
SECURE_COOKIES=false

# --- Shared with PocketBase (the service account the Rust app signs in with) ---
PB_SUPERUSER_EMAIL=service@adirehouse.local
PB_SUPERUSER_PASSWORD=change-me-long-random

# --- First run only: read by the seed migration ---
ADIRE_ADMIN_EMAIL=admin@adirehouse.local
ADIRE_ADMIN_PASSWORD=change-me-too
# Load fictional demo vendors and artworks
ADIRE_SEED_DEMO=true
